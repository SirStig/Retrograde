# Copy to .env (gitignored) and fill in. Read by Project.env() in
# build-logic, which checks environment variables first, then this file.
#
# Modrinth: https://modrinth.com/settings/pats
#   Needs "Create versions" and "Write projects". Add "Create projects"
#   as well if the project doesn't exist yet.
MODRINTH_API_TOKEN=

# CurseForge: https://legacy.curseforge.com/account/api-tokens
#   Projects can't be created through the API. Make the project on the
#   site first, wait for it to be approved, then put its numeric Project
#   ID in publish.curseforge.id in gradle.properties.
CURSEFORGE_API_TOKEN=
